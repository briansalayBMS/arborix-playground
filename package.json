{
  "name": "arborix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next node_modules/.cache",
    "dev:clean": "npm run clean && next dev",
    "build:fresh": "npm run clean && npm run build",
    "dev": "next dev -p 3000",
    "dev:fresh": "pkill -f 'next dev' ; sleep 1 && next dev -p 3000",
    "dev:turbo": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@visx/curve": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/responsive": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "framer-motion": "^12.6.5",
    "lucide-react": "^0.487.0",
    "next": "^15.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9",
    "eslint-config-next": "^15.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
